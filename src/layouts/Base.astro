---
import '../styles/global.css';
import Socials from '../components/Socials.astro';
import { site } from '../lib/releases';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  accent?: string;
}
const { title, description = site.tagline, image, accent } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const nav = [
  { href: `${base}#catalog`, label: 'Все переводы' },
  { href: `${base}#upcoming`, label: 'В работе', more: ' и в планах' },
  { href: `${base}requests/`, label: 'Стол заказов', on: path.startsWith(`${base}requests`) },
];
const ogImage = image ? new URL(image, Astro.site).href : new URL(`${base}avatar.jpg`, Astro.site).href;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08080c" />
    <link rel="icon" href={`${base}avatar.jpg`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  </head>
  <body style={accent ? `--accent:${accent}` : undefined}>
    <header class="top">
      <div class="wrap top-in">
        <a href={base} class="logo">
          <img src={`${base}avatar.jpg`} alt="" width="36" height="36" />
          <span>Innocence<b> translations</b></span>
        </a>
        <nav class="nav" aria-label="Разделы">
          {nav.map((n) => (
            <a href={n.href} class:list={{ on: n.on }} aria-current={n.on ? 'page' : undefined}>
              {n.label}
              {n.more && <span>{n.more}</span>}
            </a>
          ))}
        </nav>
        <Socials compact />
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-in">
        <div>
          <div class="foot-name">{site.name}</div>
          <p>{site.tagline}. Все релизы и новости сначала выходят в канале.</p>
          {site.contact && <p>Вопросы: <a href={`https://t.me/${site.contact}`}>@{site.contact}</a></p>}
        </div>
        <Socials />
      </div>
    </footer>

    <div class="gate" id="gate" hidden>
      <div class="gate-box">
        <div class="gate-badge">18+</div>
        <h2>Только для взрослых</h2>
        <p>На сайте описаны произведения с контентом для лиц старше 18 лет.</p>
        <div class="gate-btns">
          <button class="btn btn-accent" id="gate-yes">Мне есть 18</button>
          <a class="btn" href="https://vndb.org">Уйти</a>
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var ok = false;
        try { ok = localStorage.getItem('age18') === '1'; } catch (e) {}
        if (ok) return;
        var g = document.getElementById('gate');
        g.hidden = false;
        document.documentElement.style.overflow = 'hidden';
        document.getElementById('gate-yes').onclick = function () {
          try { localStorage.setItem('age18', '1'); } catch (e) {}
          g.hidden = true;
          document.documentElement.style.overflow = '';
        };
      })();
    </script>
  </body>
</html>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px) saturate(1.4);
    background: rgb(8 8 12 / 0.72);
    border-bottom: 1px solid var(--line);
  }
  .top-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 62px;
    gap: 12px;
  }
  .nav {
    display: flex;
    gap: 4px;
    margin-right: auto;
    margin-left: 28px;
  }
  .nav a {
    padding: 8px 13px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    color: var(--muted);
    white-space: nowrap;
    transition: color 0.2s, background 0.2s;
  }
  .nav a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.06);
  }
  .nav a.on {
    color: var(--text);
    background: rgb(255 255 255 / 0.09);
  }
  /* Узко: разделы второй строкой шапки */
  @media (max-width: 900px) {
    .top-in {
      flex-wrap: wrap;
      height: auto;
      padding: 8px 0 0;
      row-gap: 4px;
    }
    .nav {
      order: 3;
      flex-basis: 100%;
      margin: 0 -8px;
      padding-bottom: 6px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav::-webkit-scrollbar {
      display: none;
    }
    .nav a {
      padding: 7px 10px;
      font-size: 13.5px;
    }
  }
  @media (max-width: 520px) {
    .nav span {
      display: none;
    }
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 700 15px var(--head);
    white-space: nowrap;
  }
  .logo img {
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--line-2);
  }
  .logo b {
    font-weight: 500;
    color: var(--muted);
  }
  @media (max-width: 520px) {
    .logo b {
      display: none;
    }
    .foot {
      margin-top: 56px;
    }
  }
  .foot {
    margin-top: 96px;
    border-top: 1px solid var(--line);
    background: var(--bg-2);
  }
  .foot-in {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    flex-wrap: wrap;
    padding: 36px 0 44px;
    color: var(--muted);
    font-size: 14px;
  }
  .foot-in p {
    margin: 6px 0 0;
  }
  .foot-in a {
    color: var(--text);
  }
  .foot-name {
    font: 700 16px var(--head);
    color: var(--text);
  }
  .gate {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 16px;
    background: rgb(5 5 8 / 0.82);
    backdrop-filter: blur(18px);
  }
  .gate[hidden] {
    display: none;
  }
  .gate-box {
    max-width: 380px;
    text-align: center;
    padding: 32px 28px;
    border-radius: 20px;
    background: var(--bg-2);
    border: 1px solid var(--line-2);
  }
  .gate-badge {
    display: inline-grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 2px solid var(--brand);
    color: var(--brand);
    font: 700 20px var(--head);
    margin-bottom: 16px;
  }
  .gate h2 {
    font-size: 20px;
  }
  .gate p {
    color: var(--muted);
    margin: 10px 0 22px;
  }
  .gate-btns {
    display: flex;
    gap: 10px;
    justify-content: center;
  }
</style>
