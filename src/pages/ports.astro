---
// Порты: Android-версии и переносы на другие платформы
import Base from '../layouts/Base.astro';
import PortCard from '../components/PortCard.astro';
import { getPorts } from '../lib/ports';
import { icons, brands } from '../lib/icons';

const ports = await getPorts();
const count = (k: string) => ports.filter((p) => p.to.includes(k as 'pc')).length;
const steps = [
  'Скачайте APK-файл на телефон.',
  'Разрешите установку из неизвестных источников, когда Android спросит.',
  'Откройте файл и установите. Дальше как с обычной игрой.',
];
---

<Base title="Порты" description="Android-версии и порты визуальных новелл на ПК и другие платформы.">
  <div class="wrap page">
    <span class="kicker"><Fragment set:html={icons.sparkles} /> Порты</span>
    <h1>Порты <span class="count">{ports.length}</span></h1>
    <p class="lead">
      Переносим визуальные новеллы туда, где их не было: на Android и ПК. На карточке видно, с какой платформы игра и на какую перенесена.
    </p>

    <div class="filters">
      <div class="seg" role="group" aria-label="Платформа">
        <button data-to="" class="on">Все <small>{ports.length}</small></button>
        <button data-to="android"><Fragment set:html={brands.android.svg} /> Android <small>{count('android')}</small></button>
        <button data-to="pc"><Fragment set:html={icons.windows} /> ПК <small>{count('pc')}</small></button>
      </div>
      <label class="search">
        <Fragment set:html={icons.search} />
        <span class="sr-only">Поиск</span>
        <input id="q" type="search" placeholder="Название на любом языке" autocomplete="off" />
      </label>
    </div>

    <div class="grid" id="grid">
      {ports.map((p) => <PortCard p={p} />)}
    </div>
    <p class="empty" id="empty" hidden>Ничего не нашлось.</p>

    <section class="how">
      <h2>Как поставить APK</h2>
      <ol>
        {steps.map((s) => <li>{s}</li>)}
      </ol>
    </section>
  </div>
</Base>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>('#grid .card')];
  const q = document.getElementById('q') as HTMLInputElement;
  const empty = document.getElementById('empty')!;
  let to = '';

  function apply() {
    const s = q.value.trim().toLowerCase();
    let shown = 0;
    for (const c of cards) {
      const ok = (!s || c.dataset.search!.includes(s)) && (!to || c.dataset.to!.split('|').includes(to));
      c.hidden = !ok;
      if (ok) shown++;
    }
    empty.hidden = shown > 0;
  }

  q.addEventListener('input', apply);
  document.querySelectorAll<HTMLButtonElement>('[data-to]').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll('.seg [data-to]').forEach((x) => x.classList.toggle('on', x === b));
      to = b.dataset.to!;
      apply();
    }),
  );
</script>

<style>
  .page {
    padding-top: 48px;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    font: 800 12px var(--body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #3ddc84;
    background: color-mix(in srgb, #3ddc84 14%, transparent);
    border: 1px solid color-mix(in srgb, #3ddc84 35%, transparent);
  }
  h1 {
    margin-top: 16px;
    font-size: clamp(32px, 5vw, 48px);
    letter-spacing: -0.03em;
  }
  .count {
    display: inline-grid;
    place-items: center;
    min-width: 38px;
    height: 32px;
    padding: 0 9px;
    margin-left: 8px;
    border-radius: 10px;
    font-size: 18px;
    vertical-align: middle;
    color: #0b0b10;
    background: #3ddc84;
  }
  .lead {
    max-width: 640px;
    margin: 10px 0 0;
    font-size: 17px;
    color: var(--muted);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 28px 0 22px;
  }
  .seg {
    display: flex;
    padding: 4px;
    gap: 2px;
    border-radius: 12px;
    background: var(--bg-2);
    border: 1px solid var(--line);
  }
  .seg button {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 0;
    background: none;
    color: var(--muted);
    font: 600 14px var(--body);
    padding: 7px 12px;
    border-radius: 9px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .seg button small {
    font-size: 12px;
    color: var(--dim);
  }
  .seg button.on {
    background: rgb(255 255 255 / 0.1);
    color: var(--text);
  }
  .search {
    flex: 1 1 260px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    height: 44px;
    border-radius: 12px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    color: var(--dim);
    font-size: 18px;
  }
  .search:focus-within {
    border-color: var(--line-2);
  }
  .search input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    outline: 0;
    color: var(--text);
    font: inherit;
    font-size: 15px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 540px), 1fr));
    gap: 22px;
  }
  .empty {
    color: var(--muted);
    text-align: center;
    padding: 40px 0;
  }
  .empty[hidden] {
    display: none;
  }

  .how {
    margin-top: 56px;
    padding: 22px 24px;
    max-width: 640px;
    border-radius: 18px;
    background: var(--bg-2);
    border: 1px solid var(--line);
  }
  .how h2 {
    font-size: 19px;
  }
  .how ol {
    margin: 12px 0 0;
    padding-left: 22px;
    color: #d5d3de;
  }
  .how li {
    padding: 2px 0 2px 4px;
  }
  .how li::marker {
    font-weight: 800;
    color: #3ddc84;
  }

  @media (max-width: 700px) {
    .page {
      padding-top: 28px;
    }
    .lead {
      font-size: 15.5px;
    }
    .filters {
      margin: 22px 0 18px;
    }
    .seg {
      flex: 1;
    }
    .seg button {
      flex: 1;
      justify-content: center;
      padding-inline: 6px;
    }
    .search {
      flex-basis: 100%;
    }
    .grid {
      gap: 16px;
    }
    .how {
      margin-top: 40px;
      padding: 18px;
    }
  }
</style>
