---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Downloads from '../../components/Downloads.astro';
import Backdrop from '../../components/Backdrop.astro';
import Facts from '../../components/Facts.astro';
import Rating from '../../components/Rating.astro';
import Platforms from '../../components/Platforms.astro';
import Posts from '../../components/Posts.astro';
import { getReleases, censorshipLabel, type Release } from '../../lib/releases';
import { icons } from '../../lib/icons';
import { tagStyle } from '../../lib/tagcolor';

export async function getStaticPaths() {
  return (await getReleases()).filter((r) => r.status === 'released').map((r) => ({ params: { slug: r.slug }, props: { r } }));
}

const { r } = Astro.props as { r: Release };
const base = import.meta.env.BASE_URL;
const og = r.posterFile || r.imageFile ? `${base}og/${r.slug}.jpg` : undefined;
const info = r.info;
// Описание для превью ссылки: до ~200 символов, обрезка по слову
const short = r.desc && (r.desc.length > 200 ? r.desc.slice(0, 200).replace(/[\s,.;:!?-]+\S*$/, '') + '...' : r.desc);

const img = r.poster ?? r.cover ?? r.banner;
const extra = [
  r.censorship && ['Взрослые сцены', censorshipLabel[r.censorship]],
  r.date && ['Наш релиз', r.date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }).replace(' г.', '')],
].filter(Boolean) as [string, string][];

// Ссылки внутри заметки делаем кликабельными
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const note = r.note && esc(r.note).replace(/https?:\/\/\S+/g, (u) => `<a href="${u}" target="_blank" rel="noopener">${u.replace(/^https?:\/\//, '')}</a>`).replace(/\n/g, '<br>');
---

<Base title={r.title} description={short} image={og} accent={r.accent}>
  <section class="hero">
    <Backdrop src={img} width={480} />
    <div class="wrap">
      <a class="back" href={base}><Fragment set:html={icons.back} /> Все переводы</a>
      <div class="head">
        <div class="art">
          {img && <Image src={img} alt={r.title} widths={[360, 720]} sizes="(max-width: 700px) 140px, 330px" loading="eager" />}
          {r.favorite && <span class="fav" title="Любимое"><Fragment set:html={icons.star} /></span>}
        </div>
        <div class="title">
          <Platforms r={r} />
          <h1>{r.title}{r.subtitle && <span>: {r.subtitle}</span>}</h1>
          <p class="orig">{r.original}{info?.alttitle && <span> · {info.alttitle}</span>}</p>
        </div>
        <div class="info">
          <div class="mid">
            <Facts r={r} extra={extra} />
            <Rating r={r} big />
          </div>
          {r.tags.length > 0 && <div class="tags">{r.tags.map((t) => <span style={tagStyle(t)}>{t}</span>)}</div>}
          <div class="cta">
            <a class="btn btn-accent" href="#download"><Fragment set:html={icons.download} /> Скачать</a>
            <Posts r={r} big />
            {r.vndb && <a class="btn" href={`https://vndb.org/${r.vndb}`} target="_blank" rel="noopener">VNDB <Fragment set:html={icons.external} /></a>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap main">
    {r.desc && (
      <section>
        <h2 class="h">Описание</h2>
        <p class="desc">{r.desc}</p>
      </section>
    )}
    {note && <div class="note"><Fragment set:html={icons.info} /><p set:html={note} /></div>}

    <section>
      <h2 class="h">Скачать</h2>
      <Downloads r={r} />
    </section>

    {r.shots.length > 0 && (
      <section>
        <h2 class="h">Скриншоты</h2>
        <div class="shots">
          {r.shots.map((s) => (
            <a href={s.src} class="shot" data-full={s.src}>
              <Image src={s} alt="Скриншот перевода" width={640} loading="lazy" />
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <dialog id="lb"><img alt="" /></dialog>
</Base>

<script>
  const lb = document.getElementById('lb') as HTMLDialogElement;
  const img = lb.querySelector('img')!;
  document.querySelectorAll<HTMLAnchorElement>('.shot').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      img.src = a.dataset.full!;
      lb.showModal();
    }),
  );
  lb.addEventListener('click', () => lb.close());
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 26px 0 56px;
    --blur: 36px;
    --bright: 0.85;
    --shade: linear-gradient(90deg, rgb(8 8 12 / 0.2), rgb(8 8 12 / 0.55) 40%, rgb(8 8 12 / 0.7));
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 40%;
    z-index: -1;
    background: linear-gradient(transparent, var(--bg));
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 26px;
  }
  .back:hover {
    color: var(--text);
  }
  .head {
    display: grid;
    grid-template-columns: 330px minmax(0, 1fr);
    grid-template-areas:
      'art title'
      'art info';
    grid-template-rows: auto 1fr;
    column-gap: 52px;
    align-items: start;
  }
  .art {
    grid-area: art;
    position: relative;
    padding: 7px;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 30px 70px -20px rgb(0 0 0 / 0.8), 0 0 90px -20px color-mix(in srgb, var(--accent) 60%, transparent);
    transform: rotate(-2deg);
  }
  .art img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    object-position: top;
    border-radius: 14px;
  }
  .fav {
    position: absolute;
    top: 16px;
    left: 16px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    font-size: 18px;
    color: #ffd166;
    background: rgb(8 8 12 / 0.75);
    backdrop-filter: blur(6px);
  }
  .fav :global(svg) {
    fill: currentColor;
  }
  .title {
    grid-area: title;
    padding-top: 8px;
  }
  .info {
    grid-area: info;
  }
  h1 {
    font-size: clamp(30px, 4.2vw, 50px);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .orig {
    margin: 10px 0 0;
    font-size: 17px;
    font-weight: 600;
    color: var(--muted);
  }
  .orig span {
    color: var(--dim);
  }
  .mid {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 26px;
    font-size: 16px;
  }
  .mid :global(.rating) {
    padding-left: 28px;
    border-left: 1px solid var(--line-2);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }
  .tags span {
    font-size: 13.5px;
    font-weight: 700;
    padding: 4px 13px;
    border-radius: 999px;
    color: var(--tfg);
    background: var(--tbg);
    border: 1px solid var(--tbd);
  }
  .cta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .title :global(.plats) {
    margin-bottom: 16px;
  }
  @media (max-width: 1000px) {
    .head {
      grid-template-columns: 240px minmax(0, 1fr);
      column-gap: 32px;
    }
  }

  .main {
    display: grid;
    gap: 40px;
    margin-top: 8px;
  }
  .h {
    font-size: 20px;
    margin-bottom: 14px;
  }
  .desc {
    max-width: 780px;
    margin: 0;
    font-size: 16.5px;
    line-height: 1.75;
    color: #dcdae4;
  }
  .note {
    display: flex;
    gap: 12px;
    max-width: 780px;
    padding: 14px 16px;
    border-radius: var(--radius);
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    color: var(--muted);
    font-size: 14px;
  }
  .note > :global(svg) {
    font-size: 18px;
    margin-top: 2px;
    color: var(--accent);
  }
  .note p {
    margin: 0;
  }
  .note :global(a) {
    color: var(--accent);
  }
  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 12px;
  }
  .shot {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--line);
    transition: border-color 0.2s, transform 0.2s;
  }
  .shot:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .shot img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* Телефон: постер с названием рядом, факты и кнопки ниже, скриншоты лентой со свайпом */
  @media (max-width: 700px) {
    .hero {
      padding: 16px 0 32px;
    }
    .back {
      margin-bottom: 16px;
    }
    .head {
      grid-template-columns: 136px minmax(0, 1fr);
      grid-template-areas:
        'art title'
        'info info';
      column-gap: 16px;
      align-items: center;
    }
    .art {
      padding: 4px;
      border-radius: 13px;
    }
    .art img {
      border-radius: 9px;
    }
    .fav {
      top: 9px;
      left: 9px;
      width: 26px;
      height: 26px;
      font-size: 14px;
    }
    .title {
      padding: 0;
    }
    .title :global(.plats) {
      margin-bottom: 10px;
    }
    .title :global(.plat) {
      height: 26px;
      padding: 0 8px;
      font-size: 12px;
    }
    h1 {
      font-size: 23px;
    }
    .orig {
      font-size: 13.5px;
      margin-top: 6px;
    }
    .mid {
      justify-content: space-between;
      gap: 14px;
      margin-top: 22px;
      font-size: 14px;
    }
    .mid :global(.rating) {
      padding-left: 16px;
    }
    .mid :global(.rating b) {
      font-size: 34px;
    }
    .tags {
      gap: 6px;
      margin-top: 16px;
    }
    .tags span {
      font-size: 12.5px;
      padding: 3px 11px;
    }
    .cta {
      gap: 8px;
      margin-top: 20px;
    }
    .cta .btn-accent {
      flex-basis: 100%;
    }
    .cta .btn {
      flex-grow: 1;
    }
    .desc {
      font-size: 15.5px;
    }
    .shots {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: -16px;
      padding: 0 16px 4px;
      scroll-padding-inline: 16px;
      scrollbar-width: none;
    }
    .shots::-webkit-scrollbar {
      display: none;
    }
    .shot {
      flex: 0 0 86%;
      scroll-snap-align: start;
    }
  }
  dialog {
    padding: 0;
    border: 0;
    background: none;
    max-width: 94vw;
    max-height: 94vh;
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 0.85);
    backdrop-filter: blur(6px);
  }
  dialog img {
    max-width: 100%;
    max-height: 90vh;
    border-radius: 10px;
  }
</style>
