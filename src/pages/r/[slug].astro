---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Downloads from '../../components/Downloads.astro';
import Backdrop from '../../components/Backdrop.astro';
import Facts from '../../components/Facts.astro';
import Platforms from '../../components/Platforms.astro';
import Posts from '../../components/Posts.astro';
import { getReleases, censorshipLabel, type Release } from '../../lib/releases';
import { icons } from '../../lib/icons';
import { tagStyle } from '../../lib/tagcolor';

export async function getStaticPaths() {
  return (await getReleases()).filter((r) => r.status === 'released').map((r) => ({ params: { slug: r.slug }, props: { r } }));
}

const { r } = Astro.props as { r: Release };
const base = import.meta.env.BASE_URL;
const og = r.posterFile || r.imageFile ? `${base}og/${r.slug}.jpg` : undefined;
const info = r.info;
// Описание для превью ссылки: до ~200 символов, обрезка по слову
const short = r.desc && (r.desc.length > 200 ? r.desc.slice(0, 200).replace(/[\s,.;:!?-]+\S*$/, '') + '...' : r.desc);

const img = r.poster ?? r.cover ?? r.banner;
const extra = [
  r.censorship && ['Взрослые сцены', censorshipLabel[r.censorship]],
  r.date && ['Наш релиз', r.date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }).replace(' г.', '')],
].filter(Boolean) as [string, string][];

// Ссылки внутри заметки делаем кликабельными
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const note = r.note && esc(r.note).replace(/https?:\/\/\S+/g, (u) => `<a href="${u}" target="_blank" rel="noopener">${u.replace(/^https?:\/\//, '')}</a>`).replace(/\n/g, '<br>');
---

<Base title={r.title} description={short} image={og} accent={r.accent}>
  <section class="hero">
    <Backdrop src={img} width={480} />
    <div class="wrap">
      <div class="head">
        <div class="art">
          {img && <Image src={img} alt={r.title} widths={[300, 600]} sizes="(max-width: 700px) 140px, 250px" loading="eager" />}
          {r.favorite && <span class="fav" title="Любимое"><Fragment set:html={icons.star} /></span>}
        </div>
        <div class="title">
          <Platforms r={r} />
          <h1>{r.title}{r.subtitle && <span>: {r.subtitle}</span>}</h1>
          <p class="orig">{r.original}{info?.alttitle && <span> · {info.alttitle}</span>}</p>
        </div>
        <div class="info">
          <Facts r={r} extra={extra} grid />
          {r.tags.length > 0 && <div class="tags">{r.tags.map((t) => <span style={tagStyle(t)}>{t}</span>)}</div>}
          {r.desc && <p class="desc">{r.desc}</p>}
          {note && <div class="note"><Fragment set:html={icons.info} /><p set:html={note} /></div>}
          <div class="cta">
            <a class="btn btn-accent" href="#download"><Fragment set:html={icons.download} /> Скачать</a>
            <Posts r={r} big />
            {r.vndb && <a class="btn" href={`https://vndb.org/${r.vndb}`} target="_blank" rel="noopener">VNDB <Fragment set:html={icons.external} /></a>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class:list={['wrap', 'main', { two: r.shots.length > 0 }]}>
    <div class="col">
      <section>
        <h2 class="h">Скачать</h2>
        <Downloads r={r} />
      </section>
    </div>

    {r.shots.length > 0 && (
      <section>
        <h2 class="h">Скриншоты</h2>
        <div class:list={['shots', { odd: r.shots.length % 2 }]}>
          {r.shots.map((s) => (
            <a href={s.src} class="shot">
              <Image src={s} alt="Скриншот перевода" width={640} loading="lazy" />
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <dialog id="lb">
    <img alt="" />
    <button class="nav prev" aria-label="Предыдущий"><Fragment set:html={icons.back} /></button>
    <button class="nav next" aria-label="Следующий"><Fragment set:html={icons.arrow} /></button>
    <span class="count"></span>
  </dialog>
</Base>

<script>
  // Просмотр скриншотов: стрелки, клавиши, свайп; клик мимо картинки закрывает
  const lb = document.getElementById('lb') as HTMLDialogElement;
  const img = lb.querySelector('img')!;
  const count = lb.querySelector('.count')!;
  const shots = [...document.querySelectorAll<HTMLAnchorElement>('.shot')];
  let cur = 0;
  const show = (i: number) => {
    cur = (i + shots.length) % shots.length;
    img.src = shots[cur].href;
    count.textContent = `${cur + 1} / ${shots.length}`;
  };
  lb.classList.toggle('single', shots.length < 2);
  shots.forEach((a, i) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      show(i);
      lb.showModal();
    }),
  );
  lb.querySelector('.prev')!.addEventListener('click', () => show(cur - 1));
  lb.querySelector('.next')!.addEventListener('click', () => show(cur + 1));
  lb.addEventListener('click', (e) => e.target === lb && lb.close());
  img.addEventListener('click', () => show(cur + 1));
  lb.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(cur - 1);
    if (e.key === 'ArrowRight') show(cur + 1);
  });
  let x0 = 0;
  lb.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  lb.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 40) show(cur + (dx < 0 ? 1 : -1));
  });
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 30px 0 36px;
    --blur: 36px;
    --bright: 0.85;
    --shade: linear-gradient(90deg, rgb(8 8 12 / 0.2), rgb(8 8 12 / 0.62) 30%, rgb(8 8 12 / 0.72));
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    z-index: -1;
    background: linear-gradient(transparent, var(--bg));
  }
  .head {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    grid-template-areas:
      'art title'
      'art info';
    grid-template-rows: auto 1fr;
    column-gap: 44px;
    align-items: start;
  }
  .art {
    grid-area: art;
    position: relative;
    padding: 6px;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 30px 70px -20px rgb(0 0 0 / 0.8), 0 0 90px -20px color-mix(in srgb, var(--accent) 60%, transparent);
    transform: rotate(-2deg);
  }
  .art img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    object-position: top;
    border-radius: 13px;
  }
  .fav {
    position: absolute;
    top: 14px;
    left: 14px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    font-size: 17px;
    color: #ffd166;
    background: rgb(8 8 12 / 0.75);
    backdrop-filter: blur(6px);
  }
  .fav :global(svg) {
    fill: currentColor;
  }
  .title {
    grid-area: title;
  }
  .info {
    grid-area: info;
  }
  .title :global(.plats) {
    margin-bottom: 12px;
  }
  h1 {
    font-size: clamp(28px, 3.2vw, 38px);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .orig {
    margin: 6px 0 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
  }
  .orig span {
    color: var(--dim);
  }
  .info :global(.facts) {
    margin-top: 20px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 16px;
  }
  .tags span {
    font-size: 12px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 999px;
    color: var(--tfg);
    background: var(--tbg);
    border: 1px solid var(--tbd);
  }
  .desc {
    max-width: 760px;
    margin: 16px 0 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: #dcdae4;
  }
  .cta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 20px;
  }
  @media (max-width: 1000px) {
    .head {
      grid-template-columns: 200px minmax(0, 1fr);
      column-gap: 30px;
    }
  }

  /* Ниже шапки: слева загрузки и заметка, справа скриншоты */
  .main {
    display: grid;
    gap: 28px;
    margin-top: 4px;
  }
  .main.two {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 36px;
    align-items: start;
  }
  .col {
    display: grid;
    gap: 14px;
    min-width: 0;
  }
  .h {
    font-size: 18px;
    margin-bottom: 12px;
  }
  .note {
    display: flex;
    gap: 12px;
    max-width: 760px;
    margin-top: 14px;
    padding: 10px 14px;
    border-radius: var(--radius);
    background: rgb(16 16 23 / 0.7);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    color: var(--muted);
    font-size: 14px;
  }
  .note > :global(svg) {
    flex: none;
    font-size: 18px;
    margin-top: 2px;
    color: var(--accent);
  }
  .note p {
    margin: 0;
  }
  .note :global(a) {
    color: var(--accent);
  }
  .shots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  /* Нечётное число: первый скрин во всю ширину */
  .shots.odd .shot:first-child {
    grid-column: 1 / -1;
  }
  .shot {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--line);
    transition: border-color 0.2s, transform 0.2s;
  }
  .shot:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .shot img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  @media (max-width: 900px) {
    .main.two {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }

  /* Телефон: постер с названием рядом, факты и кнопки ниже, скриншоты лентой со свайпом */
  @media (max-width: 700px) {
    /* Текст на всю ширину: затемнение сверху вниз, чтобы подписи фактов читались */
    .hero {
      padding: 16px 0 26px;
      --shade: linear-gradient(rgb(8 8 12 / 0.25), rgb(8 8 12 / 0.62) 40%, rgb(8 8 12 / 0.7));
    }
    .head {
      grid-template-columns: 120px minmax(0, 1fr);
      grid-template-areas:
        'art title'
        'info info';
      column-gap: 16px;
      align-items: center;
    }
    .art {
      padding: 4px;
      border-radius: 12px;
    }
    .art img {
      border-radius: 8px;
    }
    .fav {
      top: 8px;
      left: 8px;
      width: 24px;
      height: 24px;
      font-size: 13px;
    }
    .title :global(.plats) {
      margin-bottom: 8px;
    }
    .title :global(.plat) {
      height: 24px;
      padding: 0 8px;
      font-size: 12px;
    }
    h1 {
      font-size: 22px;
    }
    .orig {
      font-size: 13px;
      margin-top: 4px;
    }
    .info :global(.facts) {
      margin-top: 18px;
    }
    .tags {
      margin-top: 14px;
    }
    .tags span {
      font-size: 11.5px;
      padding: 2px 9px;
    }
    .desc {
      margin-top: 14px;
      font-size: 14.5px;
      line-height: 1.6;
    }
    .cta {
      gap: 8px;
      margin-top: 16px;
    }
    .cta .btn-accent {
      flex-basis: 100%;
    }
    .cta .btn {
      flex-grow: 1;
    }
    .shots {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: -16px;
      padding: 0 16px 4px;
      scroll-padding-inline: 16px;
      scrollbar-width: none;
    }
    .shots::-webkit-scrollbar {
      display: none;
    }
    .shot {
      flex: 0 0 80%;
      scroll-snap-align: start;
    }
  }

  dialog {
    padding: 0;
    border: 0;
    background: none;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
  }
  dialog[open] {
    display: grid;
    place-items: center;
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 0.88);
    backdrop-filter: blur(6px);
  }
  dialog img {
    max-width: min(94vw, 1600px);
    max-height: 88vh;
    border-radius: 10px;
    cursor: pointer;
  }
  .nav {
    position: fixed;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    background: rgb(16 16 23 / 0.8);
    color: var(--text);
    font-size: 20px;
    cursor: pointer;
  }
  .nav:hover {
    background: var(--accent);
    color: #0b0b10;
  }
  .prev {
    left: 16px;
  }
  .next {
    right: 16px;
  }
  .count {
    position: fixed;
    bottom: 16px;
    left: 50%;
    translate: -50% 0;
    padding: 4px 12px;
    border-radius: 999px;
    background: rgb(16 16 23 / 0.8);
    color: var(--muted);
    font-size: 13px;
    font-weight: 700;
  }
  .single .nav,
  .single .count {
    display: none;
  }
  /* На телефоне листают свайпом, стрелки мельче */
  @media (max-width: 700px) {
    .nav {
      width: 38px;
      height: 38px;
      font-size: 17px;
    }
    .prev {
      left: 8px;
    }
    .next {
      right: 8px;
    }
  }
</style>
