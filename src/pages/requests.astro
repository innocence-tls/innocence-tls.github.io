---
// Стол заказов: бесплатная очередь и спецзаказ, ссылки на пост на каждой площадке (site.yaml → requests)
import Base from '../layouts/Base.astro';
import { site } from '../lib/releases';
import { icons, brands } from '../lib/icons';

const places = [
  { k: 'tg', label: 'Telegram', ...brands.telegram },
  { k: 'vk', label: 'ВКонтакте', ...brands.vk },
  { k: 'boosty', label: 'Boosty', ...brands.boosty },
].filter((p) => site.requests?.[p.k as 'tg' | 'vk' | 'boosty']);
const url = (k: string) => site.requests![k as 'tg' | 'vk' | 'boosty']!;
---

<Base title="Стол заказов" description="Заказать перевод визуальной новеллы: бесплатная очередь или спецзаказ.">
  <div class="wrap page">
    <span class="kicker"><Fragment set:html={icons.sparkles} /> Реквесты</span>
    <h1>Стол заказов</h1>
    <p class="lead">Хотите, чтобы мы перевели какую-то новеллу? Оставьте заявку.</p>

    <div class="ways">
      <section class="way">
        <span class="badge free">Бесплатно</span>
        <h2>Общая очередь</h2>
        <p>Берём по желанию и в порядке общей очереди.</p>
      </section>
      <section class="way">
        <span class="badge paid">Спецзаказ</span>
        <h2>Перевод под заказ</h2>
        <p>Цену и тайтл уточняйте в личке.</p>
        {
          site.contact && (
            <a class="btn" href={`https://t.me/${site.contact}`} target="_blank" rel="noopener">
              <Fragment set:html={brands.telegram.svg} /> Написать @{site.contact}
            </a>
          )
        }
      </section>
    </div>

    {
      places.length > 0 && (
        <section class="where">
          <h2>Стол заказов есть на всех площадках</h2>
          <p>Пишите туда, где вам удобнее.</p>
          <div class="places">
            {places.map((p) => (
              <a href={url(p.k)} target="_blank" rel="noopener" style={`--c:${p.color}`}>
                <span class="ico"><Fragment set:html={p.svg} /></span>
                <b>{p.label}</b>
                <Fragment set:html={icons.external} />
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .page {
    max-width: 820px;
    padding-top: 48px;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    font: 800 12px var(--body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand);
    background: color-mix(in srgb, var(--brand) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--brand) 35%, transparent);
  }
  h1 {
    margin-top: 16px;
    font-size: clamp(32px, 5vw, 48px);
    letter-spacing: -0.03em;
  }
  .lead {
    margin: 10px 0 0;
    font-size: 17px;
    color: var(--muted);
  }
  .ways {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 32px;
  }
  .way {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 22px;
    border-radius: 18px;
    background: var(--bg-2);
    border: 1px solid var(--line);
  }
  .way h2 {
    margin-top: 14px;
    font-size: 21px;
  }
  .way p {
    margin: 8px 0 0;
    color: #d5d3de;
  }
  .way .btn {
    margin-top: 18px;
  }
  .way .btn :global(svg) {
    color: #26a5e4;
  }
  .badge {
    padding: 3px 11px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 800;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--c) 35%, transparent);
  }
  .free {
    --c: #3ddc84;
  }
  .paid {
    --c: #ffd166;
  }
  .where {
    margin-top: 44px;
  }
  .where h2 {
    font-size: 21px;
  }
  .where p {
    margin: 6px 0 0;
    color: var(--muted);
  }
  .places {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px;
    margin-top: 18px;
  }
  .places a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--c) 30%, var(--line));
    background: color-mix(in srgb, var(--c) 9%, var(--bg-2));
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .places a:hover {
    border-color: var(--c);
    background: color-mix(in srgb, var(--c) 18%, var(--bg-2));
    transform: translateY(-2px);
  }
  .places .ico {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    font-size: 20px;
    color: #fff;
    background: var(--c);
  }
  .places b {
    flex: 1;
    font-size: 15.5px;
  }
  .places a > :global(svg) {
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .page {
      padding-top: 28px;
    }
    .lead {
      font-size: 15.5px;
    }
    .ways {
      grid-template-columns: 1fr;
      gap: 10px;
      margin-top: 24px;
    }
    .way {
      padding: 18px;
    }
    .where {
      margin-top: 36px;
    }
  }
</style>
