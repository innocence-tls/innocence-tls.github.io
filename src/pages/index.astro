---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Backdrop from '../components/Backdrop.astro';
import Facts from '../components/Facts.astro';
import Rating from '../components/Rating.astro';
import Platforms from '../components/Platforms.astro';
import Posts from '../components/Posts.astro';
import { getReleases, year, site } from '../lib/releases';
import { icons, brands } from '../lib/icons';

const all = await getReleases();
const released = all.filter((r) => r.status === 'released');
const upcoming = all.filter((r) => r.status !== 'released').sort((a, b) => (a.status === 'wip' ? -1 : 1) - (b.status === 'wip' ? -1 : 1));
const latest = released[0];
const latestImg = latest && (latest.poster ?? latest.cover ?? latest.banner);
const base = import.meta.env.BASE_URL;

// Теги для фильтра: самые частые сверху
const tagCount = new Map<string, number>();
released.forEach((r) => r.tags.forEach((t) => tagCount.set(t, (tagCount.get(t) ?? 0) + 1)));
const topTags = [...tagCount].sort((a, b) => b[1] - a[1]).slice(0, 14).map(([t]) => t);
---

<Base image={`${base}og/home.jpg`}>
  {
    latest && (
      <section class="hero" style={`--accent:${latest.accent}`}>
        <Backdrop src={latestImg} width={480} />
        <div class="wrap hero-in">
          <a class="hero-art" href={`${base}r/${latest.slug}/`} tabindex="-1">
            {latestImg && <Image src={latestImg} alt={latest.title} widths={[320, 640]} sizes="(max-width: 700px) 132px, 300px" loading="eager" />}
          </a>
          <div class="hero-head">
            <div class="badges">
              <span class="kicker">
                <Fragment set:html={icons.sparkles} /> Новый релиз
              </span>
              <Platforms r={latest} />
            </div>
            <h1>
              <a href={`${base}r/${latest.slug}/`}>{latest.title}{latest.subtitle && <span>: {latest.subtitle}</span>}</a>
            </h1>
            <p class="hero-orig">{latest.original}</p>
          </div>
          <div class="hero-body">
            <div class="hero-mid">
              <Facts r={latest} />
              <Rating r={latest} big />
            </div>
            {latest.tags.length > 0 && <div class="hero-tags">{latest.tags.slice(0, 6).map((t) => <span>{t}</span>)}</div>}
            {latest.desc && <p class="hero-desc">{latest.desc}</p>}
            <div class="hero-btns">
              <a class="btn btn-accent" href={`${base}r/${latest.slug}/#download`}>
                <Fragment set:html={icons.download} /> Скачать
              </a>
              <a class="btn" href={`${base}r/${latest.slug}/`}>
                Подробнее <Fragment set:html={icons.arrow} />
              </a>
              <Posts r={latest} big />
            </div>
          </div>
        </div>
      </section>
    )
  }

  <div class="wrap">
    <div class="intro" id="catalog">
      <div>
        <h2>Все переводы <span class="count">{released.length}</span></h2>
        <p>Переводы визуальных новелл на русский. Жмите на карточку для получения подробной информации и ссылок на скачивание.</p>
      </div>
    </div>

    <div class="filters">
      <label class="search">
        <Fragment set:html={icons.search} />
        <span class="sr-only">Поиск</span>
        <input id="q" type="search" placeholder="Название на любом языке или тег" autocomplete="off" />
      </label>
      <div class="seg" role="group" aria-label="Платформа">
        <button data-plat="" class="on">Все</button>
        <button data-plat="pc"><Fragment set:html={icons.pc} /> ПК</button>
        <button data-plat="android"><Fragment set:html={brands.android.svg} /> Android</button>
      </div>
      <select id="sort" aria-label="Сортировка">
        <option value="date">Сначала новые</option>
        <option value="title">По алфавиту</option>
      </select>
    </div>
    <div class="chips-wrap">
      <div class="chips" role="group" aria-label="Теги">
        {topTags.map((t) => <button data-tag={t}>{t}</button>)}
      </div>
    </div>

    <div class="grid" id="grid" data-per="10">
      {released.map((r) => <Card r={r} />)}
    </div>
    <p class="empty" id="empty" hidden>Ничего не нашлось. Попробуйте другое название или сбросьте фильтры.</p>
    <nav class="pager" id="pager" aria-label="Страницы" hidden></nav>

    {
      upcoming.length > 0 && (
        <>
          <h2 class="section-title" id="upcoming">
            В работе и в планах <small>{upcoming.length}</small>
          </h2>
          <div class="up">
            {upcoming.map((r) => (
              <a class="up-card" href={r.vndb ? `https://vndb.org/${r.vndb}` : undefined} target="_blank" rel="noopener" style={`--accent:${r.accent}`}>
                <div class="up-img">
                  {(r.poster ?? r.banner) && <Image src={(r.poster ?? r.banner)!} alt={r.title} width={300} />}
                  <span class:list={['up-st', r.status]}>{r.status === 'wip' ? 'Переводится' : 'В планах'}</span>
                </div>
                <b>{r.title}</b>
                <small>{r.original}</small>
                {r.progress != null && (
                  <div class="bar" title={`${r.progress}%`}>
                    <i style={`width:${r.progress}%`} />
                  </div>
                )}
              </a>
            ))}
          </div>
        </>
      )
    }
  </div>
</Base>

<script>
  const grid = document.getElementById('grid')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('.card')];
  const q = document.getElementById('q') as HTMLInputElement;
  const sort = document.getElementById('sort') as HTMLSelectElement;
  const empty = document.getElementById('empty')!;
  const pager = document.getElementById('pager')!;
  let plat = '';
  let page = 1;
  const tags = new Set<string>();

  // Фильтры, потом страница: на странице не больше data-per карточек
  function apply(keepPage = false) {
    const per = +grid.dataset.per! || 10;
    const s = q.value.trim().toLowerCase();
    const found = [...grid.querySelectorAll<HTMLElement>('.card')].filter(
      (c) =>
        (!s || c.dataset.search!.includes(s)) &&
        (!plat || c.dataset.platforms!.split('|').includes(plat)) &&
        [...tags].every((t) => c.dataset.tags!.split('|').includes(t)),
    );
    const pages = Math.max(1, Math.ceil(found.length / per));
    if (!keepPage) page = 1;
    page = Math.min(page, pages);
    const from = (page - 1) * per;
    const visible = new Set(found.slice(from, from + per));
    for (const c of cards) c.hidden = !visible.has(c);
    empty.hidden = found.length > 0;
    renderPager(pages);
  }

  // Номера страниц: первая, последняя и соседи текущей, между ними многоточие
  function renderPager(pages: number) {
    pager.hidden = pages < 2;
    pager.innerHTML = '';
    if (pages < 2) return;
    const btn = (label: string, to: number, cls = '', disabled = false) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = label;
      b.className = cls;
      b.disabled = disabled;
      b.addEventListener('click', () => {
        page = to;
        apply(true);
        document.getElementById('catalog')!.scrollIntoView({ behavior: 'smooth' });
      });
      pager.appendChild(b);
    };
    btn('←', page - 1, 'arrow', page === 1);
    let prev = 0;
    for (let n = 1; n <= pages; n++) {
      if (n !== 1 && n !== pages && Math.abs(n - page) > 1) continue;
      if (n - prev > 1) pager.appendChild(Object.assign(document.createElement('span'), { textContent: '...' }));
      btn(String(n), n, n === page ? 'on' : '');
      prev = n;
    }
    btn('→', page + 1, 'arrow', page === pages);
  }

  q.addEventListener('input', () => apply());
  document.querySelectorAll<HTMLButtonElement>('[data-plat]').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll('[data-plat]').forEach((x) => x.classList.toggle('on', x === b));
      plat = b.dataset.plat!;
      apply();
    }),
  );
  document.querySelectorAll<HTMLButtonElement>('[data-tag]').forEach((b) =>
    b.addEventListener('click', () => {
      const t = b.dataset.tag!;
      tags.has(t) ? tags.delete(t) : tags.add(t);
      b.classList.toggle('on', tags.has(t));
      apply();
    }),
  );
  sort.addEventListener('change', () => {
    const by = sort.value;
    cards
      .sort((a, b) => (by === 'title' ? a.dataset.title!.localeCompare(b.dataset.title!, 'ru') : +b.dataset.date! - +a.dataset.date!))
      .forEach((c) => grid.appendChild(c));
    apply();
  });
  apply();
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 52px 0 60px;
    --blur: 36px;
    --bright: 0.85;
    --shade: linear-gradient(90deg, rgb(8 8 12 / 0.2), rgb(8 8 12 / 0.55) 40%, rgb(8 8 12 / 0.7));
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 45%;
    z-index: -1;
    background: linear-gradient(transparent, var(--bg));
  }
  .hero-in {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    grid-template-areas:
      'art head'
      'art body';
    grid-template-rows: auto 1fr;
    column-gap: 52px;
    align-items: start;
  }
  .hero-art {
    grid-area: art;
    display: block;
    padding: 7px;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 30px 70px -20px rgb(0 0 0 / 0.8), 0 0 80px -20px color-mix(in srgb, var(--accent) 60%, transparent);
    transform: rotate(-2deg);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hero-art:hover {
    transform: rotate(0) scale(1.02);
  }
  .hero-art img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    object-position: top;
    border-radius: 14px;
  }
  .hero-head {
    grid-area: head;
    padding-top: 6px;
  }
  .hero-body {
    grid-area: body;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    font: 800 12px var(--body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, rgb(10 10 16 / 0.5));
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .hero h1 {
    font-size: clamp(30px, 4.2vw, 50px);
    margin-top: 16px;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .hero-orig {
    margin: 8px 0 0;
    font-size: 17px;
    font-weight: 600;
    color: var(--muted);
  }
  .hero-mid {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 24px;
    font-size: 16px;
  }
  .hero-mid :global(.rating) {
    padding-left: 28px;
    border-left: 1px solid var(--line-2);
  }
  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .hero-tags span {
    font-size: 13.5px;
    font-weight: 700;
    padding: 4px 13px;
    border-radius: 999px;
    color: #eeedf3;
    background: rgb(10 10 16 / 0.55);
    border: 1px solid rgb(255 255 255 / 0.14);
  }
  .hero-desc {
    max-width: 640px;
    margin: 20px 0 0;
    color: #d8d6e0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hero-btns {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 26px;
    flex-wrap: wrap;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  @media (max-width: 900px) {
    .hero-in {
      grid-template-columns: 220px minmax(0, 1fr);
      column-gap: 32px;
    }
  }
  /* Телефон: постер с названием рядом, остальное ниже на всю ширину */
  @media (max-width: 700px) {
    .hero {
      padding: 22px 0 34px;
    }
    .hero-in {
      grid-template-columns: 132px minmax(0, 1fr);
      grid-template-areas:
        'art head'
        'body body';
      column-gap: 16px;
      align-items: center;
    }
    .hero-art {
      padding: 4px;
      border-radius: 13px;
    }
    .hero-art img {
      border-radius: 9px;
    }
    .kicker {
      font-size: 10.5px;
      padding: 4px 10px;
    }
    .badges {
      gap: 6px;
    }
    .badges :global(.lbl) {
      display: none;
    }
    .badges :global(.plat) {
      height: 26px;
      padding: 0 7px;
    }
    .hero h1 {
      font-size: 22px;
      margin-top: 10px;
    }
    .hero-orig {
      font-size: 13.5px;
      margin-top: 6px;
    }
    .hero-mid {
      justify-content: space-between;
      gap: 14px;
      margin-top: 20px;
      font-size: 14px;
    }
    .hero-mid :global(.rating) {
      padding-left: 16px;
    }
    .hero-mid :global(.rating b) {
      font-size: 34px;
    }
    .hero-tags {
      gap: 6px;
      margin-top: 16px;
    }
    .hero-tags span {
      font-size: 12.5px;
      padding: 3px 11px;
    }
    .hero-desc {
      font-size: 14.5px;
      margin-top: 16px;
    }
    .hero-btns {
      gap: 8px;
      margin-top: 18px;
    }
    .hero-btns .btn-accent {
      flex-basis: 100%;
    }
    .hero-btns .btn {
      flex-grow: 1;
    }
  }

  .intro {
    margin: 44px 0 18px;
  }
  .intro h2 {
    font-size: 24px;
  }
  .count {
    display: inline-grid;
    place-items: center;
    min-width: 34px;
    height: 28px;
    padding: 0 8px;
    margin-left: 6px;
    border-radius: 9px;
    font-size: 15px;
    vertical-align: middle;
    color: #0b0b10;
    background: var(--brand);
  }
  #catalog,
  #upcoming {
    scroll-margin-top: 84px;
  }
  @media (max-width: 900px) {
    #catalog,
    #upcoming {
      scroll-margin-top: 112px;
    }
  }
  .intro p {
    margin: 6px 0 0;
    color: var(--muted);
  }

  .filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
  }
  .search {
    flex: 1 1 280px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    height: 44px;
    border-radius: 12px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    color: var(--dim);
    font-size: 18px;
  }
  .search:focus-within {
    border-color: var(--line-2);
  }
  .search input {
    flex: 1;
    background: none;
    border: 0;
    outline: 0;
    color: var(--text);
    font: inherit;
    font-size: 15px;
    min-width: 0;
  }
  .seg {
    display: flex;
    padding: 4px;
    gap: 2px;
    border-radius: 12px;
    background: var(--bg-2);
    border: 1px solid var(--line);
  }
  .seg button,
  .chips button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 0;
    background: none;
    color: var(--muted);
    font: 600 14px var(--body);
    padding: 7px 12px;
    border-radius: 9px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .seg button.on {
    background: rgb(255 255 255 / 0.1);
    color: var(--text);
  }
  select {
    height: 44px;
    padding: 0 12px;
    border-radius: 12px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    color: var(--text);
    font: 600 14px var(--body);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 24px;
  }
  .chips button {
    font-size: 13px;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
  }
  .chips button:hover {
    color: var(--text);
  }
  .chips button.on {
    color: #0b0b10;
    background: var(--brand);
    border-color: transparent;
  }

  /* Телефон: поиск на всю ширину, платформа и сортировка в одну строку, теги лентой со свайпом */
  @media (max-width: 700px) {
    .intro {
      margin-top: 32px;
    }
    .intro h2 {
      font-size: 21px;
    }
    .intro p {
      font-size: 14.5px;
    }
    .search {
      flex-basis: 100%;
    }
    .seg {
      flex: 1;
    }
    .seg button {
      flex: 1;
      justify-content: center;
      padding-inline: 6px;
    }
    select {
      flex: 0 0 auto;
      max-width: 42%;
    }
    .chips-wrap {
      position: relative;
      margin: 12px -16px 20px;
    }
    .chips-wrap::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 32px;
      pointer-events: none;
      background: linear-gradient(90deg, transparent, var(--bg));
    }
    .chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin: 0;
      padding: 0 16px;
      scrollbar-width: none;
    }
    .chips::-webkit-scrollbar {
      display: none;
    }
    .chips button {
      flex: none;
      padding: 7px 14px;
    }
    .grid {
      gap: 16px;
    }
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 540px), 1fr));
    gap: 22px;
  }
  .grid > :global([hidden]) {
    display: none;
  }
  .pager {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 28px;
  }
  .pager[hidden] {
    display: none;
  }
  .pager :global(button) {
    min-width: 42px;
    height: 42px;
    padding: 0 12px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg-2);
    color: var(--muted);
    font: 700 15px var(--body);
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .pager :global(button:hover:not(:disabled)) {
    color: var(--text);
    border-color: var(--line-2);
  }
  .pager :global(button.on) {
    color: #0b0b10;
    background: var(--brand);
    border-color: transparent;
  }
  .pager :global(button:disabled) {
    opacity: 0.35;
    cursor: default;
  }
  .pager :global(span) {
    color: var(--dim);
    padding: 0 4px;
  }
  .empty {
    color: var(--muted);
    text-align: center;
    padding: 40px 0;
  }

  .up {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 18px;
  }
  .up-card {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14px;
  }
  .up-card small {
    color: var(--dim);
    font-size: 12.5px;
  }
  .up-img {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 8px;
    background: var(--bg-3);
    border: 1px solid var(--line);
    transition: border-color 0.3s, transform 0.3s;
  }
  .up-card:hover .up-img {
    border-color: var(--accent);
    transform: translateY(-4px);
  }
  .up-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85);
  }
  .up-st {
    position: absolute;
    left: 8px;
    bottom: 8px;
    font-size: 11.5px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgb(8 8 12 / 0.8);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line-2);
  }
  .up-st.wip {
    color: #7cf0a8;
  }
  .up-st.planned {
    color: var(--muted);
  }
  .bar {
    height: 4px;
    margin-top: 6px;
    border-radius: 99px;
    background: rgb(255 255 255 / 0.08);
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    background: var(--accent);
  }
</style>
