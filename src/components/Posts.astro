---
// Кнопки на посты релиза: Telegram, VK, Boosty
import type { Release } from '../lib/releases';
import { postMeta } from '../lib/icons';

const { r, big = false } = Astro.props as { r: Release; big?: boolean };
const posts = (['tg', 'vk', 'boosty'] as const).filter((k) => r.posts[k]).map((k) => [k, r.posts[k]!] as const);
---

{
  posts.length > 0 && (
    <div class:list={['posts', { big }]}>
      {posts.map(([k, u]) => (
        <a href={u} target="_blank" rel="noopener" title={postMeta[k].label} aria-label={postMeta[k].label} style={`--c:${postMeta[k].color}`}>
          <Fragment set:html={postMeta[k].svg} />
        </a>
      ))}
    </div>
  )
}

<style>
  .posts {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 6px;
  }
  .posts a {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    font-size: 16px;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 15%, rgb(10 10 16 / 0.5));
    border: 1px solid color-mix(in srgb, var(--c) 30%, transparent);
    transition: background 0.2s, color 0.2s, transform 0.2s;
  }
  .posts a:hover {
    background: var(--c);
    color: #fff;
    transform: translateY(-2px);
  }
  .big a {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    font-size: 19px;
  }
</style>
