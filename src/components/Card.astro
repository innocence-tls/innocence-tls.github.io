---
// Карточка каталога: постер слева, справа название, факты, рейтинг, теги, платформы и кнопки.
// Вся карточка кликабельна через растянутую ссылку, кнопки лежат поверх неё.
import { Image } from 'astro:assets';
import type { Release } from '../lib/releases';
import { icons } from '../lib/icons';
import Backdrop from './Backdrop.astro';
import Facts from './Facts.astro';
import Rating from './Rating.astro';
import Platforms from './Platforms.astro';
import Posts from './Posts.astro';

const { r } = Astro.props as { r: Release };
const href = `${import.meta.env.BASE_URL}r/${r.slug}/`;
const img = r.poster ?? r.cover ?? r.banner;
const search = [r.title, r.subtitle, r.original, r.info?.alttitle, ...r.tags].filter(Boolean).join(' ').toLowerCase();
---

<article
  class="card"
  style={`--accent:${r.accent}`}
  data-search={search}
  data-tags={r.tags.join('|')}
  data-platforms={r.platforms.join('|')}
  data-date={r.date?.getTime() ?? 0}
  data-title={r.title}
>
  <Backdrop src={img} />
  <div class="poster">
    {img && <Image src={img} alt={r.title} widths={[240, 400]} sizes="(max-width: 700px) 120px, 190px" loading="lazy" />}
    {r.favorite && <span class="fav" title="Любимое"><Fragment set:html={icons.star} /></span>}
  </div>
  <div class="head">
    <h3>
      <a class="main" href={href}>{r.title}{r.subtitle && <span>: {r.subtitle}</span>}</a>
    </h3>
    <p class="orig">{r.original}</p>
  </div>
  <div class="mid">
    <Facts r={r} />
    <Rating r={r} />
  </div>
  {r.tags.length > 0 && <div class="tags">{r.tags.slice(0, 6).map((t) => <span>{t}</span>)}</div>}
  <div class="foot">
    <Platforms r={r} />
    <div class="act">
      <Posts r={r} />
      <a class="more" href={href} tabindex="-1">Подробнее <Fragment set:html={icons.arrow} /></a>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    grid-template-rows: auto auto 1fr auto;
    grid-template-areas:
      'poster head'
      'poster mid'
      'poster tags'
      'poster foot';
    column-gap: 22px;
    padding: 16px 18px 16px 16px;
    border-radius: 20px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s, border-color 0.35s;
    container: card / inline-size;
    --bright: 0.6;
  }
  .card :global(.backdrop img) {
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .card:hover,
  .card:focus-within {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: 0 20px 50px -18px color-mix(in srgb, var(--accent) 70%, transparent);
  }
  .card:hover :global(.backdrop img) {
    transform: scale(1.08);
  }
  .main::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .main:focus-visible {
    outline: none;
  }
  .card:has(.main:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .poster {
    grid-area: poster;
    position: relative;
    align-self: start;
    padding: 4px;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.92);
    box-shadow: 0 14px 34px -10px rgb(0 0 0 / 0.7);
    transform: rotate(-1.5deg);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .card:hover .poster {
    transform: rotate(0) scale(1.02);
  }
  .poster img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    object-position: top;
    border-radius: 10px;
  }
  .fav {
    position: absolute;
    top: 10px;
    left: 10px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    font-size: 15px;
    color: #ffd166;
    background: rgb(8 8 12 / 0.75);
    backdrop-filter: blur(6px);
  }
  .fav :global(svg) {
    fill: currentColor;
  }

  .head {
    grid-area: head;
    padding-top: 4px;
  }
  h3 {
    font-size: 21px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  h3 span {
    color: var(--accent);
  }
  .orig {
    margin: 5px 0 0;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--muted);
  }
  .mid {
    grid-area: mid;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    margin-top: 14px;
    font-size: 14px;
  }
  .mid :global(.rating) {
    flex: none;
    padding-left: 14px;
    border-left: 1px solid var(--line-2);
  }
  .tags {
    grid-area: tags;
    align-self: start;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .tags span {
    font-size: 12.5px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 999px;
    color: #e6e4ee;
    background: rgb(10 10 16 / 0.55);
    border: 1px solid rgb(255 255 255 / 0.12);
  }
  .foot {
    grid-area: foot;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
  }
  .act {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .more {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 13px;
    border-radius: 10px;
    font-size: 13.5px;
    font-weight: 700;
    color: #0b0b10;
    background: var(--accent);
    white-space: nowrap;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .more:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 24px -8px var(--accent);
  }

  /* Узкая карточка: у платформ только иконки, чтобы кнопки влезли в строку */
  @container card (max-width: 660px) {
    .foot :global(.lbl) {
      display: none;
    }
    .foot :global(.plat) {
      width: 34px;
      height: 34px;
      padding: 0;
      justify-content: center;
    }
  }

  /* Телефон: постер с названием и фактами рядом, теги и кнопки на всю ширину */
  @media (max-width: 700px) {
    .card {
      grid-template-columns: 112px minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'poster head'
        'poster mid'
        'tags tags'
        'foot foot';
      column-gap: 14px;
      padding: 12px;
      border-radius: 18px;
    }
    .poster {
      padding: 3px;
      border-radius: 11px;
    }
    .poster img {
      border-radius: 8px;
    }
    .fav {
      top: 7px;
      left: 7px;
      width: 24px;
      height: 24px;
      font-size: 13px;
    }
    .head {
      padding-top: 2px;
    }
    h3 {
      font-size: 17px;
    }
    .orig {
      font-size: 12.5px;
    }
    .mid {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      margin-top: 10px;
      font-size: 12.5px;
    }
    .mid :global(.facts dt) {
      font-weight: 700;
    }
    .mid :global(.rating) {
      flex-direction: row;
      align-items: baseline;
      gap: 8px;
      padding: 0;
      border: 0;
    }
    .mid :global(.rating b) {
      font-size: 22px;
    }
    .mid :global(.rating svg) {
      font-size: 16px;
    }
    .tags {
      margin-top: 14px;
    }
    .tags span {
      font-size: 12px;
    }
    .foot {
      margin-top: 12px;
    }
    .card:hover {
      transform: none;
    }
  }
</style>
