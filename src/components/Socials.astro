---
import { site } from '../lib/releases';
import { socialMeta } from '../lib/icons';

const { compact = false } = Astro.props as { compact?: boolean };
const list = Object.entries(site.socials).filter(([k]) => socialMeta[k]);
---

<nav class:list={['soc', { compact }]} aria-label="Соцсети">
  {
    list.map(([k, url]) => (
      <a href={url} target="_blank" rel="noopener" style={`--c:${socialMeta[k].color}`} title={socialMeta[k].label}>
        <Fragment set:html={socialMeta[k].svg} />
        <span>{socialMeta[k].label}</span>
      </a>
    ))
  }
</nav>

<style>
  .soc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .soc a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.03);
    font-weight: 700;
    font-size: 14px;
    color: var(--text);
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }
  .soc a :global(svg) {
    font-size: 18px;
    color: var(--c);
  }
  .soc a:hover {
    border-color: var(--c);
    background: color-mix(in srgb, var(--c) 14%, transparent);
  }
  .compact {
    gap: 4px;
    flex-wrap: nowrap;
  }
  .compact a {
    padding: 8px;
    border-color: transparent;
    background: none;
  }
  .compact a span {
    display: none;
  }
  .compact a :global(svg) {
    font-size: 20px;
    color: var(--muted);
    transition: color 0.2s;
  }
  .compact a:hover :global(svg) {
    color: var(--c);
  }
</style>
